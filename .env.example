# Backend
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./data/facelock.db
STORAGE_DIR=./data/uploads
ACCESS_TOKEN_MINUTES=1440
FACE_MATCH_THRESHOLD=0.346
UNKNOWN_MATCH_THRESHOLD=0.36
FACE_MATCH_MARGIN=0.04
FACE_TRACK_THRESHOLD=0.30
FACE_CONFIRMATION_FRAMES=2
UNKNOWN_HOLD_SECONDS=2.0
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Gmail SMTP (use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend (LAN IP on local Wi-Fi, or an HTTPS/Tailscale address for remote access)
EXPO_PUBLIC_API_URL=http://localhost:8000

